# En développement : laisser vide (le proxy Vite redirige /api vers localhost:8080)
# VITE_API_URL=

# En production (Vercel) : mettre l'URL de votre backend Render/Railway
VITE_API_URL=https://your-backend.onrender.com

# Cloudinary — upload des images produits (https://cloudinary.com, tier gratuit)
# Dashboard > Settings > Upload > Upload presets > Add unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
